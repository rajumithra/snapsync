PROJECT_NAME="SnapSync Live Photo Relay"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Security & Tokens
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Database
# Use postgresql+asyncpg://user:password@localhost:5432/snapsync_db in production
# Default sqlite fallback for instant zero-dependency local development:
DATABASE_URL="sqlite+aiosqlite:///./snapsync.db"

# Storage
# Options: "local", "s3", "supabase"
STORAGE_PROVIDER="local"
LOCAL_STORAGE_DIR="./storage_uploads"
PUBLIC_CDN_URL="http://localhost:8000/static/uploads"

# AWS / Cloudflare R2 S3 Config (if STORAGE_PROVIDER="s3")
S3_BUCKET_NAME="snapsync-photos"
S3_REGION="us-east-1"
S3_ENDPOINT_URL=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Face Recognition
FACE_SIMILARITY_THRESHOLD=0.60
MAX_UPLOAD_SIZE_MB=50

